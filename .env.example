# HTTP listener
PORT=3000
HOST=0.0.0.0
# SQLite and content-addressed uploads
SABBIA_DATA_DIR=./data
# 1 enables the deterministic offline mock provider (no provider network calls)
SABBIA_MOCK=0
# OpenAI-compatible NVIDIA endpoint
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Comma-separated keys; required unless mock mode or a keys file is used
NVIDIA_API_KEY=
# Optional newline-separated keys file, merged and deduplicated
NVIDIA_KEYS_FILE=
# Maximum individual uploaded file size in MiB
SABBIA_MAX_UPLOAD_MB=25
# Minimum normalized lexical retrieval score, in [0,1]
SABBIA_RETRIEVAL_MIN_SCORE=0.18
# debug | info | warn | error
SABBIA_LOG_LEVEL=info

# Public demo abuse protection (restart after changes)
# All requests per client IP; token bucket per minute
SABBIA_RATE_LIMIT_PER_MIN=120
# Model route admissions per client IP per minute
SABBIA_MODEL_RATE_LIMIT_PER_MIN=6
# Model route admissions across all clients per minute
SABBIA_MODEL_RATE_LIMIT_GLOBAL_PER_MIN=60
# Global model route budget; resets at 00:00 UTC
SABBIA_MODEL_BUDGET_PER_DAY=1500
# Source and asset uploads per client IP per hour
SABBIA_UPLOAD_RATE_PER_HOUR=10
# Simultaneous SSE responses across all clients
SABBIA_MAX_CONCURRENT_STREAMS=40
# Simultaneous SSE responses per client IP
SABBIA_MAX_CONCURRENT_STREAMS_PER_IP=3
# Total stored upload objects across sources and assets, in MiB
SABBIA_MAX_UPLOAD_TOTAL_MB=500
# Maximum sources per corpus
SABBIA_MAX_SOURCES=50
# Anonymous data retention; hourly cleanup preserves operator rows
SABBIA_RETENTION_DAYS=14
# Maximum JSON request body, in KiB
SABBIA_MAX_JSON_KB=256
# SQLite metadata, chunks, events and telemetry ceiling, in MiB
SABBIA_MAX_DATABASE_MB=512
# Optional operator token for the three destructive routes; unset by default
SABBIA_AUTH_TOKEN=
# Dense retrieval and the separate passage judge (restart after changes)
SABBIA_DENSE_RETRIEVAL=1
# Model-specific cosine floor; calibrate for the embedding model (default 0.15)
SABBIA_DENSE_MIN_SCORE=0.15
SABBIA_JUDGE_RETRIEVAL=1

# Maximum raw passages judged per turn; bounded parallel provider requests
SABBIA_JUDGE_MAX_SEGMENTS=10
SABBIA_JUDGE_CONCURRENCY=5
# Verify grounded answers and regenerate at most once
SABBIA_VERIFY_ANSWERS=1
